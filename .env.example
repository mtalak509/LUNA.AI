# Скопируйте в `.env` и подставьте свои значения.
# Источник имён переменных: core/config.py (InfraConfig).

# Server settings
HOST=0.0.0.0
PORT=8000
RELOAD=false
ALLOWED_ORIGINS=*
# Session root is fixed in code (~/.luna/sessions) — not configurable here.
# Префикс за ingress (напр. /agent); пусто = без префикса
ROOT_PATH=

# Logging settings
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE=logs/app.log

# Выбор LLM-провайдера для чат-модели: gpustack | openrouter | ollama.
# Влияет только на LLM; embedding-эндпоинт (EMBEDDING_*) не зависит от флага.
LLM_PROVIDER=openrouter

# GPUStack / vLLM (LLM-провайдер по умолчанию, OpenAI-совместимый Responses API)
GPUSTACK_BASE_URL=http://localhost:8080/v1
GPUSTACK_API_KEY=
GPUSTACK_LLM_MODEL=qwen3.6-35b-a3b-awq-4bit
GPUSTACK_TIMEOUT=120
GPUSTACK_RETRIES=2

# OpenRouter (публичный OpenAI-совместимый шлюз, Chat Completions).
# Активируется при LLM_PROVIDER=openrouter.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=qwen/qwen3-235b-a22b
OPENROUTER_TIMEOUT=120
OPENROUTER_RETRIES=2

# Embedding-эндпоинт (ОТДЕЛЬНЫЙ сервер от LLM — свой URL и ключ)
EMBEDDING_BASE_URL=http://localhost:8080/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest

# Ollama (локальный LLM через OpenAI-совместимый эндпоинт, Chat Completions).
# Активируется при LLM_PROVIDER=ollama. /v1 к base_url добавляется автоматически.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_LLM_MODEL=qwen3.6-35b-a3b-awq-4bit
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
OLLAMA_TIMEOUT=60
OLLAMA_RETRIES=2
OLLAMA_EMBED_KEEP_ALIVE=-1m

# Feature flags (отключаемые подсистемы; проводка сохранена)
RAG_ENABLED=false

# Qdrant (RAG: коллекция knowledge_base)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_USE_SSL=false
QDRANT_PREFIX=

# HTTP transport defaults (BaseHTTPClient: embedding endpoint и внешние API)
HTTP_TIMEOUT_S=30.0
HTTP_RETRIES=3
HTTP_BACKOFF_BASE_S=0.5
